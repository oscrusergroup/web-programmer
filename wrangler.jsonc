{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cartreader-web-programmer",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "routes": [ { "pattern": "programmer.oscruser.group", "custom_domain": true } ],
  "vars": { "FIRMWARE_BACKEND": "cloudflare" },
  "services": [
    { "binding": "FIRMWARE_SERVICE", "service": "cartreader-firmware" },
    { "binding": "WORKER_SELF_REFERENCE", "service": "cartreader-web-programmer" }
  ],
  "previews": {
    "vars": { "FIRMWARE_BACKEND": "cloudflare" },
    "services": [
      { "binding": "FIRMWARE_SERVICE", "service": "cartreader-firmware-preview" }
    ]
  },
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "cartreader-web-programmer-staging",
      "routes": [ { "pattern": "staging.programmer.oscruser.group", "custom_domain": true } ],
      "vars": { "FIRMWARE_BACKEND": "cloudflare" },
      "services": [
        { "binding": "FIRMWARE_SERVICE", "service": "cartreader-firmware-preview" },
        { "binding": "WORKER_SELF_REFERENCE", "service": "cartreader-web-programmer-staging" }
      ]
    }
  }
}
