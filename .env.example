# Set this to the public HTTPS origin when deploying behind a reverse proxy.
# APP_ORIGIN=https://reader.example.com

# Optional override for the CLI executable. The project-local toolchain
# and .arduino/arduino-cli.yaml are still installed by setup:arduino.
# ARDUINO_CLI_PATH=/usr/local/bin/arduino-cli

# Optional location for the downloaded firmware source cache.
# Use the same value during setup, build, and runtime.
# FIRMWARE_CACHE_DIR=/var/cache/cartreader-firmware
