{
  "name": "cartreader-web-programmer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "predev": "node scripts/prepare-development.mjs",
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "prebuild": "node scripts/prepare-development.mjs",
    "build": "node scripts/build.mjs",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run setup:firmware",
    "test": "node --import tsx --test tests/*.test.ts",
    "setup:firmware": "node scripts/setup-firmware.mjs",
    "setup:arduino": "node scripts/setup-arduino.mjs",
    "cf:build": "node scripts/cloudflare.mjs build",
    "cf:preview": "node scripts/cloudflare.mjs preview",
    "cf:deploy:web": "node scripts/cloudflare.mjs deploy",
    "cf:deploy:firmware": "node scripts/cloudflare.mjs deploy-firmware",
    "cf:deploy:firmware:preview": "node scripts/cloudflare.mjs deploy-firmware --env preview",
    "cf:deploy:preview": "pnpm run cf:deploy:firmware:preview && pnpm exec wrangler preview",
    "cf:deploy": "pnpm run cf:deploy:firmware && pnpm run cf:build && pnpm run cf:deploy:web",
    "cf:dev:firmware": "wrangler dev --config wrangler.firmware.jsonc --port 8787",
    "cf:types": "wrangler types --include-runtime=false --config wrangler.firmware.jsonc cloudflare/worker-env.d.ts && wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:bucket": "wrangler r2 bucket create cartreader-build-cache",
    "cf:bucket:preview": "wrangler r2 bucket create cartreader-build-cache-preview"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@opennextjs/cloudflare": "^1.20.11",
    "lucide-react": "^0.468.0",
    "next": "16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.0"
  }
}
